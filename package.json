    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "lucide-static": "^1.61.0",
    "obsidian": "1.13.1",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0"
  },
  "author": "Jcolorxy"
}

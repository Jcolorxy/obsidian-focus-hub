  "description": "Tasks with statuses, comments and images; a daily Today view; per-note Gantt timelines with dependencies and critical path.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
